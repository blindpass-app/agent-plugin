{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "blindpass": {
      "type": "streamable-http",
      "url": "https://api.blindpass.app/mcp"
    },
    "blindpass-pat": {
      "type": "streamable-http",
      "url": "https://api-pat.blindpass.app/mcp",
      "headers": {
        "Authorization": "Bearer ${BLINDPASS_PAT}"
      }
    }
  }
}
